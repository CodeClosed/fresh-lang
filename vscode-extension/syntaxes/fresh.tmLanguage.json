{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fresh",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#types"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fresh",
          "match": "\\b(if|else|while|for|break|continue|return|match)\\b"
        },
        {
          "name": "keyword.declaration.fresh",
          "match": "\\b(let|fn|struct|import)\\b"
        },
        {
          "name": "constant.language.fresh",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.fresh",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.fresh",
          "match": "\\b(int|float|bool|string)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fresh",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fresh",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fresh",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fresh",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fresh",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    }
  },
  "scopeName": "source.fresh"
}
