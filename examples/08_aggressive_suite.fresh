let m_pow = pow(2.0, 10.0);
let m_min = min(100, 25);
let m_max = max(100, 25);
let m_floor = floor(5.8);
let m_ceil = ceil(5.2);
let m_round = round(5.5);

if (m_abs != 42.7 || m_sqrt != 4.0 || m_pow != 1024.0 || m_min != 25 || m_max != 100 || m_floor != 5.0 || m_ceil != 6.0 || m_round != 6.0) {
    println("FAIL: Math library failed");
} else {
    println("[OK] Standard math library functions passed");
}

