fn swap(arr: [int], i: int, j: int) {
    let temp = arr[i];
    arr[i] = arr[j];
    arr[j] = temp;
}

fn partition(arr: [int], low: int, high: int) -> int {
    let pivot = arr[high];
    let i = low - 1;
    for (let j = low; j < high; j = j + 1) {
        if (arr[j] <= pivot) {
            i = i + 1;
            swap(arr, i, j);
        }
    }
    swap(arr, i + 1, high);
    return i + 1;
}

fn quicksort(arr: [int], low: int, high: int) {
    if (low < high) {
        let pi = partition(arr, low, high);
        quicksort(arr, low, pi - 1);
        quicksort(arr, pi + 1, high);
    }
}

let numbers = [64, 34, 25, 12, 22, 11, 90];

println("Before sort: " + to_string(numbers));

quicksort(numbers, 0, len(numbers) - 1);

println("After quicksort: " + to_string(numbers));
