fn fib_recursive(n: int) -> int {
    if (n <= 1) {
        return n;
    }
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

fn fib_iterative(n: int) -> int {
    if (n <= 1) {
        return n;
    }
    let a = 0;
    let b = 1;
    for (let i = 2; i <= n; i = i + 1) {
        let temp = a + b;
        a = b;
        b = temp;
    }
    return b;
}

println("--- Fibonacci Benchmarks ---");

let t0 = clock();

let r1 = fib_recursive(20);

let t1 = clock();

println("Recursive fib(20) = " + to_string(r1));

let t2 = clock();

let r2 = fib_iterative(20);

let t3 = clock();

println("Iterative fib(20) = " + to_string(r2));
