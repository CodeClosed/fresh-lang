println("--- 6. Dynamic Arrays & Matrices ---");

let numbers: [int] = [10, 20, 30, 40];

println("Initial array: " + to_string(numbers));

numbers[1] = 99;

println("Mutated index 1: " + to_string(numbers[1]));

push(numbers, 50);

