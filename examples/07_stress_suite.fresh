let integer_val: int = -42;

let float_val: float = 3.14159;

let bool_val: bool = true;

let str_val: string = "Hello,\\t\\\"Fresh\\\"!\\n";

let nil_val = nil;

println("--- 1. Data Types & Types ---");

println("Integer: " + to_string(integer_val) + " | Type: " + type(integer_val));

println("Float: " + to_string(float_val) + " | Type: " + type(float_val));

println("Boolean: " + to_string(bool_val) + " | Type: " + type(bool_val));

println("String: " + str_val + " | Type: " + type(str_val));

println("Nil: " + to_string(nil_val) + " | Type: " + type(nil_val));

println("--- 2. Operators & Precedence ---");

let op_test1 = 1 + 2 * 3;

let op_test2 = 1 + 2 * 3;

let mod_val = 10 % 3;

let neg_val = -op_test1;

let not_val = !bool_val;

let logic_val = op_test1 == 7 && op_test2 > 5 || !not_val;

println("1 + 2 * 3 = " + to_string(op_test1));

println("(1 + 2) * 3 = " + to_string(op_test2));

println("10 % 3 = " + to_string(mod_val));

println("Negation: " + to_string(neg_val));

println("Logical expression: " + to_string(logic_val));

println("--- 3. Control Flow ---");

let score = 85;

if (score >= 90) {
    println("Score Grade: A");
} else {
    if (score >= 80) {
        println("Score Grade: B");
    } else {
        println("Score Grade: C");
    }
}

let while_counter = 0;

let while_sum = 0;

while (while_counter < 5) {
    while_sum = while_sum + while_counter;
    while_counter = while_counter + 1;
}

println("While loop sum (0 to 4): " + to_string(while_sum));

let loop_results: [int] = [];

for (let i = 0; i < 10; i = i + 1) {
    if (i == 3) {
        continue;
    }
    if (i == 7) {
        break;
    }
    push(loop_results, i);
}

println("For loop with continue (skip 3) and break (at 7): " + to_string(loop_results));

println("--- 4. Functions & Closures ---");

let add_res = add(15, 27);

println("Named function add(15, 27): " + to_string(add_res));

let fib_res = fibonacci(10);

println("Recursive fibonacci(10): " + to_string(fib_res));

let multiply = fn(x: int, y: int) -> int {
    return x * y;
};

println("Lambda multiply(6, 7): " + to_string(multiply(6, 7)));

let counter_a = make_counter(0);

let counter_b = make_counter(100);

println("Closure A count 1: " + to_string(counter_a()));

println("Closure A count 2: " + to_string(counter_a()));

println("Closure B count 1: " + to_string(counter_b()));

println("Closure A count 3: " + to_string(counter_a()));

println("--- 5. Structs & Mutation ---");

let pt = Point { x: 1.5, y: 2.5 };

println("Point initial: x=" + to_string(pt.x) + ", y=" + to_string(pt.y));

pt.x = 10.0;

pt.y = 20.0;

println("Point mutated: x=" + to_string(pt.x) + ", y=" + to_string(pt.y));

