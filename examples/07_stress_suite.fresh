struct Point { x: float, y: float }

struct Person { name: string, age: int, is_active: bool }

fn add(a: int, b: int) -> int {
    return a + b;
}

fn fibonacci(n: int) -> int {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn make_counter(start: int) -> fn {
    let count = start;
    fn increment() -> int {
        count = count + 1;
        return count;
    }
    return increment;
}

fn evaluate_code(code: int) -> string {
    return match code { 200 => "OK", 404 => "Not Found", 500 => "Server Error", c if c >= 400 && c < 500 => "Client Error (" + to_string(c) + ")", _ => "Unknown Code" };
}

