fn quicksort(arr: [int], low: int, high: int) -> int {
    if (low < high) {
        let pivot = arr[high];
        let i = low - 1;
        for (let j = low; j < high; j = j + 1) {
            if (arr[j] <= pivot) {
                i = i + 1;
                let tmp = arr[i];
                arr[i] = arr[j];
                arr[j] = tmp;
            }
        }
        let p_idx = i + 1;
        let tmp2 = arr[p_idx];
        arr[p_idx] = arr[high];
        arr[high] = tmp2;

        quicksort(arr, low, p_idx - 1);
        quicksort(arr, p_idx + 1, high);
    }
    return 0;
}

// Generate deterministic pseudo-random array of 2000 elements
let SIZE = 2000;
let arr: [int] = [];
let seed = 42;
for (let i = 0; i < SIZE; i = i + 1) {
    seed = (seed * 1103515245 + 12345) % 2147483647;
    push(arr, seed % 10000);
}

quicksort(arr, 0, SIZE - 1);
println("QuickSort Completed. Min: " + to_string(arr[0]) + ", Max: " + to_string(arr[SIZE - 1]));
