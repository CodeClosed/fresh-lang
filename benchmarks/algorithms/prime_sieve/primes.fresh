fn count_primes(limit: int) -> int {
    let count = 0;
    for (let n = 2; n <= limit; n = n + 1) {
        let is_prime = true;
        for (let d = 2; d * d <= n; d = d + 1) {
            if (n % d == 0) {
                is_prime = false;
                break;
            }
        }
        if (is_prime) {
            count = count + 1;
        }
    }
    return count;
}

let total = count_primes(10000);
println("Primes count up to 10000: " + to_string(total));
