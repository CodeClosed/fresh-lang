fn calculate_tax(amount: float, rate: float) -> float {
    return amount * rate;
}

let item_price = 199.99;

let tax_rate = 0.08;

let tax = calculate_tax(item_price, tax_rate);

let total = item_price + tax;

println("Item Price: $" + to_string(item_price));

println("Tax (8%):   $" + to_string(tax));

println("Total:      $" + to_string(total));
